# Niceland – Apache-Konfiguration (Hetzner Webhosting)
# Vor dem Livegang prüfen: HTTPS-Zertifikat gilt für niceland-hamburg.de UND www.niceland-hamburg.de.

Options -Indexes
ServerSignature Off
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType image/webp .webp

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ---------- HTTPS und eine einheitliche Adresse (www) ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTP -> HTTPS (und gleich auf www)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://www.niceland-hamburg.de%{REQUEST_URI} [L,R=301]

    # ohne www -> mit www (passend zur Canonical-URL)
    RewriteCond %{HTTP_HOST} ^niceland-hamburg\.de$ [NC]
    RewriteRule ^ https://www.niceland-hamburg.de%{REQUEST_URI} [L,R=301]

    # Versteckte Dateien und Ordner (z. B. .git, .env) sperren
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# ---------- Dateien, die nie ausgeliefert werden sollen ----------
<FilesMatch "(\.(md|json|lock|log|sql|bak|ini|sh|yml|yaml|dist|swp)|~)$">
    Require all denied
</FilesMatch>

# ---------- Sicherheits-Header ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
    # Skripte, Styles, Bilder und Schriften nur von der eigenen Domain.
    # Ausnahme: Google Maps und Google-Bewertungen (nur nach Einwilligung).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://maps.googleapis.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://maps.googleapis.com https://places.googleapis.com; frame-src https://www.google.com https://maps.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

    # HTML nie lange zwischenspeichern, damit Änderungen sofort sichtbar sind
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ---------- Kompression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml text/xml application/xml
</IfModule>

# ---------- Zwischenspeicher im Browser ----------
# CSS/JS tragen eine Versionsnummer (?v=...) und werden bei Änderungen neu geladen.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
</IfModule>
